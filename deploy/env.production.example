# StockWhisk — production environment. Copy to /srv/stockwhisk/.env and fill in.
# chmod 600 this file. NEVER commit it.

# --- Core --------------------------------------------------------------------
DEBUG=False
SECRET_KEY=REPLACE_WITH_60+_RANDOM_CHARS        # python -c "import secrets;print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
TIME_ZONE=Asia/Dhaka

# --- Database (PostgreSQL) ---------------------------------------------------
DB_ENGINE=postgres
DB_NAME=stockwhisk
DB_USER=stockwhisk
DB_PASSWORD=REPLACE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (SMTP) ------------------------------------------------------------
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
DEFAULT_FROM_EMAIL=StockWhisk <no-reply@example.com>

# --- CORS (lock down) --------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- JWT / throttle ----------------------------------------------------------
JWT_ACCESS_MIN=60
JWT_REFRESH_DAYS=7
AUTH_THROTTLE_RATE=10/min

# --- Gunicorn ----------------------------------------------------------------
WEB_CONCURRENCY=5
GUNICORN_BIND=unix:/run/stockwhisk/gunicorn.sock
