# StockWhisk — docker-compose env. Copy to ./.env (repo root) and fill in.
# DB_HOST and REDIS_URL are set by compose — do not override here.

DEBUG=False
SECRET_KEY=REPLACE_WITH_60+_RANDOM_CHARS
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
TIME_ZONE=Asia/Dhaka

# Database (compose creates this postgres with these values)
DB_ENGINE=postgres
DB_NAME=stockwhisk
DB_USER=stockwhisk
DB_PASSWORD=REPLACE_ME
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Email (optional; console backend used if EMAIL_HOST unset)
# EMAIL_HOST=smtp.provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StockWhisk <no-reply@example.com>

CORS_ALLOW_ALL_ORIGINS=False
AUTH_THROTTLE_RATE=10/min
WEB_CONCURRENCY=5

# Host port nginx binds to
HTTP_PORT=80
