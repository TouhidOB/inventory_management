[Unit]
Description=StockWhisk Celery worker
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=stockwhisk
Group=www-data
WorkingDirectory=/srv/stockwhisk
EnvironmentFile=/srv/stockwhisk/.env
ExecStart=/srv/stockwhisk/.venv/bin/celery -A config worker --loglevel=info --concurrency=4
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
