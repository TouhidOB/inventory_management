# Copy to .env and adjust. Everything has a safe local default.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Dhaka

# Database engine: sqlite (default) | postgres | mysql
DB_ENGINE=sqlite
# DB_NAME=stockwhisk
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Celery/Redis. Leave REDIS_URL empty for eager (synchronous) local execution.
REDIS_URL=

# JWT lifetimes
JWT_ACCESS_MIN=60
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI insights (Phase 3)
ANTHROPIC_API_KEY=
